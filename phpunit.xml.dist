<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit configuration for Guardian's CMS-independent unit tests.

    These tests do NOT bootstrap TYPO3. Most exercise pure Domain, Application
    and Infrastructure logic; the handful under Tests/Unit/Integration,
    Tests/Unit/Middleware and Tests/Unit/Typo3 type-hint TYPO3 classes and so
    need the framework on the autoloader, which `composer install` provides
    through the typo3/cms-core requirement. Either way the suite runs with a
    plain `vendor/bin/phpunit` once dependencies are installed; see
    Documentation/Testing.md for the commands and the TYPO3 13.4 / 14 matrix.

    Running it therefore requires `composer install` first — a working copy with
    no vendor/ cannot execute it, and that is the only reason it would be
    reported as not executed.

    The attributes used below (source/include, cacheDirectory, failOnWarning,
    failOnRisky) and the #[Test]/#[DataProvider] attributes in the tests are all
    valid in PHPUnit 10.5 and 11, so this file works with the whole
    "^10.5 || ^11.0" range Guardian allows across TYPO3 13.4 and 14.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Guardian domain unit tests">
            <directory>Tests/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">Classes/Domain</directory>
            <directory suffix=".php">Classes/Application</directory>
        </include>
    </source>
</phpunit>
