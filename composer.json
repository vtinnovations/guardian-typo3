{
    "name": "vtinnovations/guardian-typo3",
    "type": "typo3-cms-extension",
    "description": "Guardian for TYPO3 \u2014 admin update, backup, and recovery cockpit for TYPO3 13.4 and 14.",
    "license": "LGPL-3.0-or-later",
    "keywords": [
        "typo3",
        "backup",
        "update",
        "recovery",
        "composer",
        "maintenance"
    ],
    "homepage": "https://www.v-t.one",
    "authors": [
        {
            "name": "V&T Innovations Team",
            "homepage": "https://www.v-t.one",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://www.v-t.one"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-json": "*",
        "ext-sodium": "*",
        "typo3/cms-core": "^13.4.9 || ^14.0",
        "typo3/cms-backend": "^13.4.9 || ^14.0",
        "symfony/process": "^6.4 || ^7.0",
        "psr/log": "^3.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "suggest": {
        "ext-zip": "Required for creating backup archives (ZipArchive).",
        "ext-pdo": "Used by the pure-PHP database dump fallback when mysqldump is unavailable."
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "typo3/testing-framework": "^8.2.3 || ^9.0"
    },
    "autoload": {
        "psr-4": {
            "Vtinnovations\\GuardianTypo3\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vtinnovations\\GuardianTypo3\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "guardian_typo3",
            "web-dir": "public"
        }
    }
}
